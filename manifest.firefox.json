{
    "manifest_version": 3,
    "name": "Nozo",
    "version": "1.0.10",
    "description": "Alt + click (Option + click on macOS) any link to peek at it in a modal window.",
    "browser_specific_settings": {
        "gecko": {
            "id": "nozo@z3r0.github.io",
            "strict_min_version": "113.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ]
}